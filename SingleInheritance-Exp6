6)Single Inheritance
A company wants to manage employee salary details. All employees have common details such as employee ID, name, and basic salary. Permanent employees receive an additional HRA and DA.
Tasks
Create a superclass Employee.
Create a subclass PermanentEmployee.
Calculate the gross salary.
Display all employee details.

import java.util.Scanner;
class Employee {
    int empId;
    String name;
    double basicSalary;

    void getDetails() {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Employee ID: ");
        empId = sc.nextInt();

        System.out.print("Enter Name: ");
        name = sc.next();

        System.out.print("Enter Basic Salary: ");
        basicSalary = sc.nextDouble();
    }

    void displayDetails() {
        System.out.println("Employee ID: " + empId);
        System.out.println("Name: " + name);
        System.out.println("Basic Salary: " + basicSalary);
    }
}

class PermanentEmployee extends Employee {
    double hra, da, grossSalary;

    void calculateSalary() {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter HRA: ");
        hra = sc.nextDouble();

        System.out.print("Enter DA: ");
        da = sc.nextDouble();

        grossSalary = basicSalary + hra + da;
    }

    void displaySalary() {
        displayDetails();
        System.out.println("HRA: " + hra);
        System.out.println("DA: " + da);
        System.out.println("Gross Salary: " + grossSalary);
    }
}

public class PermanentEmployee {
    public static void main(String[] args) {
        PermanentEmployee e = new PermanentEmployee();
        e.getDetails();
        e.calculateSalary();

        System.out.println("\n--- Employee Details ---");
        e.displaySalary();
    }
}
