11a) FileInputStream and FileOutputStream

import java.io.*;

public class Main {
    public static void main(String[] args) throws Exception {

        String data = "Name: Yashaswini\nAge: 20\nCourse: CSE";

        FileOutputStream out = new FileOutputStream("profile.txt");
        out.write(data.getBytes());
        out.close();

        FileInputStream in = new FileInputStream("profile.txt");
        int ch;

        while ((ch = in.read()) != -1) {
            System.out.print((char) ch);
        }

        in.close();
    }
}

11b) FileWriter and FileReader

import java.io.*;

public class Main {
    public static void main(String[] args) throws Exception {

        FileWriter fw = new FileWriter("data.txt");
        fw.write("Welcome to Java Programming");
        fw.close();

        FileReader fr = new FileReader("data.txt");
        int ch;

        while ((ch = fr.read()) != -1) {
            System.out.print((char) ch);
        }

        fr.close();
    }
}

